{
  "name": "obsidian-ttrpg-audio-manager",
  "version": "0.0.0",
  "description": "Plugin to play local audio files",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "lint": "eslint . --config eslint.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "prepare": "husky",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.10",
    "esbuild-sass-plugin": "^3.3.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.3",
    "obsidian": "^1.8.7",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts}": [
      "eslint --config eslint.config.mjs --fix",
      "npm test --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
