{
  "name": "obsidian-ttrpg-audio-manager",
  "version": "0.0.0",
  "description": "Plugin to play local audio files",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "lint": "eslint . --config eslint.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "prepare": "husky",
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.9",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.27.2",
    "esbuild-sass-plugin": "^3.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.7",
    "obsidian": "^1.11.4",
    "prettier": "^3.8.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts}": [
      "eslint --config eslint.config.mjs --fix",
      "npm test --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
